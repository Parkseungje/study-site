# 이 파일을 .env.local 로 복사해서 값을 채운다. .env.local 은 git 에 안 올라간다.
# 운영은 Vercel 프로젝트 → Settings → Environment Variables 에 같은 이름으로 넣는다.
#
# 읽기 전용 사이트는 이 값들이 없어도 뜬다. 어드민만 잠긴다.

# GitHub fine-grained personal access token
#   Repository access : 이 저장소 하나만
#   Permissions       : Contents → Read and write (이것만)
GITHUB_TOKEN=

# 커밋을 올릴 저장소
GITHUB_REPO=Parkseungje/study-site

# 어드민 로그인 비밀번호. 공개 주소라 길게 잡는다 (20자 이상 권장)
ADMIN_PASSWORD=

# 로그인 쿠키 서명용 랜덤 문자열.
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
ADMIN_SECRET=

# 기본값은 main. 다른 브랜치에 커밋하려면 바꾼다.
# GITHUB_BRANCH=main

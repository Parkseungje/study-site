# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files — DB 접속 정보가 들어가므로 .env 는 올리지 않는다.
# .env.example 은 템플릿이라 커밋한다.
.env
.env.local
.env.*.local

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# DB 백업 덤프
/backup

# Prisma 가 생성하는 클라이언트. postinstall 에서 다시 만든다.
/src/generated

# IDE
.idea/
.vscode/
